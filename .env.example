# Content-Agent-Lernapp — names only, never real values.
# Canonical list: docs/ENV.md (audit 2026-10-02).

# --- App / Pipeline (Vercel + Cloud Agent) ---
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# Optional: claude-sonnet-5-5 (Default) | claude-haiku-4-5-20251001 (D-41)
GENERATOR_MODEL=
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU-Host laut Langfuse Data-Regions-Docs (Ireland). Nicht den US-Host verwenden.
LANGFUSE_BASE_URL=
# Optional Langfuse SDK v5 tracing attrs (env-only; not set in code).
LANGFUSE_TRACING_ENVIRONMENT=
LANGFUSE_RELEASE=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only — never NEXT_PUBLIC_. Bypasses RLS for pipeline writes.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: force in-memory mock-store (tests / local without DB).
COURSE_STORAGE=

# Optional: Next.js browser aliases — same values as SUPABASE_URL / SUPABASE_ANON_KEY.
# Canonical secrets are SUPABASE_URL and SUPABASE_ANON_KEY (already used in Cloud Agent / Vercel).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Observability (optional; no-op when empty) ---
# Sentry EU: create project with Data Storage Location = EU (DSN host ingest.de.sentry.io).
# Docs: https://docs.sentry.io/platforms/javascript/guides/nextjs/
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload in Vercel build und Fehlerzahl für den Planer (SIN-259; Lesezugriff genügt, never commit the token).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional, Default https://de.sentry.io (EU)
SENTRY_BASE_URL=
# PostHog Cloud EU — host must be https://eu.i.posthog.com
# Docs: https://posthog.com/docs/libraries/next-js
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Hermes / Railway EU (AP-10) ---
RAILWAY_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HERMES_APP_BASE_URL=
