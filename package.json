{
  "name": "content-agent-lernapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43123",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "COURSE_STORAGE=mock node --import tsx --test $(find src -name \"*.test.ts\")",
    "typecheck": "tsc --noEmit",
    "quality:sync-goldset": "node --import tsx scripts/ap06-sync-goldset.ts",
    "quality:calibrate": "node --import tsx scripts/ap06-calibrate.ts",
    "quality:smoke": "node --import tsx scripts/ap06-smoke.ts",
    "ap15:phase-a": "node --import tsx scripts/ap15-phase-a.ts",
    "ap15:phase-a:dry": "node --import tsx scripts/ap15-phase-a.ts --dry-run",
    "test:a11y": "playwright test",
    "test:lighthouse": "node scripts/lighthouse-gate.mjs http://127.0.0.1:43123/",
    "hermes:dry-run": "node --import tsx scripts/hermes-dry-run.mjs",
    "pilot:maf": "node --import tsx scripts/pilot-maf.mjs",
    "supabase:verify": "node scripts/verify-supabase-schema.mjs",
    "lock:assemble": "node scripts/assemble-package-lock.mjs",
    "content:mermaid": "node scripts/mermaid-to-svg.mjs",
    "prebuild": "node scripts/mermaid-to-svg.mjs",
    "pretest": "node scripts/materialize-goldset.mjs",
    "goldset:materialize": "node scripts/materialize-goldset.mjs",
    "ap15:regen-dropped": "node --import tsx scripts/ap15-regen-dropped.ts",
    "ap15:regen-dropped:dry": "node --import tsx scripts/ap15-regen-dropped.ts --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@langfuse/client": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "lighthouse": "^12.8.2",
    "mermaid": "^11.17.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0"
  }
}
