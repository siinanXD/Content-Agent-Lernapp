{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lauf-Bericht content (SIN-491)",
  "description": "Zahlen eines Laufs. Kosten in Euro.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agent", "lauf", "erzeugt", "ungueltig", "repariert", "verworfen", "kostenEur", "status"],
  "properties": {
    "schema": { "type": "string", "pattern": "content\\.schema\\.json$" },
    "agent": { "const": "content" },
    "lauf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "datum"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "datum": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "erzeugt": { "type": "integer", "minimum": 0 },
    "ungueltig": { "type": "integer", "minimum": 0 },
    "repariert": { "type": "integer", "minimum": 0 },
    "verworfen": { "type": "integer", "minimum": 0 },
    "kostenEur": { "type": "number", "minimum": 0 },
    "status": { "enum": ["ok", "teilweise", "fehler", "abgebrochen"] },
    "hinweis": { "type": "string" }
  }
}
