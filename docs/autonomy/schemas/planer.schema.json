{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue-Vorlagen des Planers (SIN-491)",
  "description": "Liste von Issue-Vorlagen; höchstens 5 pro Woche.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "issues"],
  "properties": {
    "schema": { "type": "string", "pattern": "planer\\.schema\\.json$" },
    "issues": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titel", "ziel", "umsetzung", "akzeptanzkriterien", "labels", "agent", "budget"],
        "properties": {
          "titel": { "type": "string", "minLength": 1 },
          "ziel": { "type": "string", "minLength": 1 },
          "umsetzung": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "akzeptanzkriterien": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "labels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "agent": { "enum": ["research", "planer", "design", "coding", "pruefen", "betrieb", "content", "video", "marketing"] },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["groesse", "apiEur"],
            "properties": {
              "groesse": { "enum": ["klein", "mittel"] },
              "apiEur": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
