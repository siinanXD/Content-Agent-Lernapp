{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research-Bericht (SIN-491)",
  "description": "JSON neben der Markdown-Datei in docs/research/. Jede Preisangabe hat eine Quelle und ein Abrufdatum.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "thema", "erstellt", "wunsch", "konkurrenten", "bausteine", "modelle", "kosten", "empfehlung"],
  "properties": {
    "schema": { "type": "string", "pattern": "research\\.schema\\.json$" },
    "thema": { "type": "string", "minLength": 1 },
    "erstellt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "wunsch": { "type": "string", "minLength": 1 },
    "konkurrenten": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "staerken", "schwaechen"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "staerken": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "schwaechen": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "bausteine": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "lizenz", "sterne", "letzterCommit"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "lizenz": { "type": "string", "minLength": 1 },
          "sterne": { "type": ["integer", "null"], "minimum": 0 },
          "letzterCommit": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    },
    "modelle": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "preisEingabeUsdProMio", "preisAusgabeUsdProMio", "quelle", "abgerufen"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "preisEingabeUsdProMio": { "type": "number", "minimum": 0 },
          "preisAusgabeUsdProMio": { "type": "number", "minimum": 0 },
          "quelle": { "type": "string", "pattern": "^https://" },
          "abgerufen": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    },
    "kosten": {
      "type": "object",
      "additionalProperties": false,
      "required": ["einmaligEur", "proMonatEur", "annahme"],
      "properties": {
        "einmaligEur": { "type": ["number", "null"], "minimum": 0 },
        "proMonatEur": { "type": ["number", "null"], "minimum": 0 },
        "annahme": { "type": "string", "minLength": 1 }
      }
    },
    "empfehlung": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entscheidung", "begruendung"],
      "properties": {
        "entscheidung": { "enum": ["bauen", "nutzen", "verwerfen", "beobachten"] },
        "begruendung": { "type": "string", "minLength": 1 }
      }
    }
  }
}
